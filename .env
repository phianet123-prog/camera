# Copy this file to .env and fill in your own values. Never commit .env.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SENDER_EMAIL=youraccount@gmail.com
SENDER_PASSWORD=your16charapppassword
RECEIVER_EMAIL=alerts-go-here@example.com

# Optional — WhatsApp alerts via Twilio. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+15551234567

# Optional tuning — all have sane defaults if you leave these out.
MAX_CAPTURE_FILES=200
MAX_CAPTURES_MB=1024
NIGHT_MODE_THRESHOLD=70
TAMPER_STD_THRESHOLD=8
TAMPER_CONSECUTIVE_FRAMES=30
TAMPER_ALERT_COOLDOWN_SECONDS=300
FAR_DETECTION_HEIGHT_RATIO=0.25
ZOOM_CROP_PADDING=0.6
ZOOM_INSET_SIZE=220
VIDEO_SEGMENT_SECONDS=300
ALERT_COOLDOWN_SECONDS=25
CAMERA_FALLBACK_FPS=15
YOLO_IMGSZ=640
JPEG_QUALITY=80

# --- Reliability ---
CAMERA_RECONNECT_DELAY_SECONDS=5
CAMERA_MAX_RECONNECT_DELAY_SECONDS=60
WATCHDOG_INTERVAL_SECONDS=15
DETECTION_PERSISTENCE_FRAMES=3

# --- Security ---
# Serves the dashboard over HTTPS with an auto-generated self-signed
# certificate (fine for your own LAN; browsers will show a one-time
# warning since it's not from a public CA). Requires: pip install cryptography
HTTPS_ENABLED=false

# --- Offsite backup ---
# No .env setup needed — go to Settings → Offsite backup in the
# dashboard and click "Connect OneDrive" (or configure another rclone
# provider). Left here only as documentation of what's possible.
